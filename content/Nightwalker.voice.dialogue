# Nightwalker owner-recorded supplemental dialogue
# schema 1
# Loaded after Nightwalker.dialogue. Complete exchanges stay together.
schema=1

# First approach: one shared warning followed by one of two alternate performances.
line=saint_denis.recorded_opening.take_a|sd_recorded_open_a_01|THE VAMPIRE|nw.sd.opening.warning|nw.audio.sd.opening.warning|2250|Come no nearer.
line=saint_denis.recorded_opening.take_a|sd_recorded_open_a_02|THE VAMPIRE|nw.sd.opening.wiser.a|nw.audio.sd.opening.wiser.a|5200|There. You have proven yourself wiser than the last.
