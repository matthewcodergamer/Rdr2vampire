# Nightwalker narrative voice manifest
# schema 1
# asset=<audio-id>|<relative WAV path>
#
# Explicit mappings are optional. If an audio id is not listed here, Nightwalker
# automatically tries: audio/<audio-id>.wav
#
# Paths must remain relative to the Nightwalker plugin directory, may not contain
# '..', and must end in .wav. Only original/licensed voice recordings belong here.
schema=1

# Voice batch 1 — owner-supplied Nightwalker AI voice takes.
asset=nw.audio.sd.first_contact.nearer.01|audio/nw.audio.sd.first_contact.nearer.01.wav
asset=nw.audio.sd.first_contact.wiser.01|audio/nw.audio.sd.first_contact.wiser.01.wav
asset=nw.audio.sd.first_contact.wiser.02|audio/nw.audio.sd.first_contact.wiser.02.wav
asset=nw.audio.sd.question.names.01|audio/nw.audio.sd.question.names.01.wav
asset=nw.audio.sd.question.names.02|audio/nw.audio.sd.question.names.02.wav
asset=nw.audio.sd.question.none.01|audio/nw.audio.sd.question.none.01.wav
asset=nw.audio.sd.question.none.02|audio/nw.audio.sd.question.none.02.wav
