# Nightwalker owner-recorded supplemental dialogue
# schema 1
# Loaded after Nightwalker.dialogue. Complete exchanges stay together.
schema=1

# Standalone recorded soul answer. Kept separate from the partially voiced base exchange.

# QUESTION — Saint Denis itself. The complete three-line answer is selected as one unit.
line=saint_denis.choice.question.city_01|sd_vb2_city_01a|THE VAMPIRE|nw.sd.vb2.city.01a|nw.audio.sd.question.city.01a|4741|A thousand souls pressed together behind brick and iron.
line=saint_denis.choice.question.city_01|sd_vb2_city_01b|THE VAMPIRE|nw.sd.vb2.city.01b|nw.audio.sd.question.city.01b|2129|Look around you.
line=saint_denis.choice.question.city_01|sd_vb2_city_01c|THE VAMPIRE|nw.sd.vb2.city.01c|nw.audio.sd.question.city.01c|1815|Keep it.

# LEAVE — three distinct performances. Only one is selected per withdrawal.
line=saint_denis.choice.leave.rare_wisdom_01|sd_vb2_leave_01|THE VAMPIRE|nw.sd.vb2.leave.01|nw.audio.sd.leave.rare_wisdom.01|3522|A rare wisdom.
line=saint_denis.choice.leave.rare_wisdom_02|sd_vb2_leave_02|THE VAMPIRE|nw.sd.vb2.leave.02|nw.audio.sd.leave.rare_wisdom.02|2311|A rare wisdom.

# Sustained aim warning. Physical posture acts as the player's next "word."
line=saint_denis.react.aim_hold.care_01|sd_vb2_aimhold_01|THE VAMPIRE|nw.sd.vb2.aimhold.01|nw.audio.sd.aimhold.care.01|4036|Choose your next words with greater care.

# QUESTION — church/faith answer. The two cryptic clauses remain paired.
line=saint_denis.choice.question.church_01|sd_vb2_church_01a|THE VAMPIRE|nw.sd.vb2.church.01a|nw.audio.sd.question.church.01a|3700|He has gone farther from you than I ever could.
line=saint_denis.choice.question.church_01|sd_vb2_church_01b|THE VAMPIRE|nw.sd.vb2.church.01b|nw.audio.sd.question.church.01b|1606|From him.
